# ==============================================================================
# KNOWLEDGEFLOW — GLOBAL ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env and configure values according to your local environment.
# Never commit .env files containing real secrets or credentials to git.

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 2. MONGODB DATABASE (MAIN APP PERSISTENCE)
# ------------------------------------------------------------------------------
MONGO_URI=mongodb://mongodb:27017/knowledgeflow
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=example_dev_password

# ------------------------------------------------------------------------------
# 3. REDIS & BULLMQ (JOBS, QUEUES & CACHING)
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# ------------------------------------------------------------------------------
# 4. IDENTITY PROVIDER (KEYCLOAK)
# ------------------------------------------------------------------------------
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_REALM=KnowledgeFlow
KEYCLOAK_CLIENT_ID_FRONTEND=knowledgeflow-frontend
KEYCLOAK_CLIENT_ID_BACKEND=knowledgeflow-backend
KEYCLOAK_ISSUER_URL=http://localhost:8080/realms/KnowledgeFlow
KEYCLOAK_JWKS_URI=http://keycloak:8080/realms/KnowledgeFlow/protocol/openid-connect/certs
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_dev_password

# Database dedicated to Keycloak (PostgreSQL)
KEYCLOAK_DB_HOST=keycloak-db
KEYCLOAK_DB_PORT=5432
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak_dev_password

# ------------------------------------------------------------------------------
# 5. INTERNAL AI SERVICE (PYTHON / FASTAPI) & GEMINI
# ------------------------------------------------------------------------------
AI_SERVICE_URL=http://ai-service:8000
INTERNAL_SERVICE_SECRET=change_this_internal_shared_secret_for_dev_mode
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 6. DOCUMENT PROCESSING & RAG CONFIGURATION
# ------------------------------------------------------------------------------
MAX_FILE_SIZE_MB=15
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=5
